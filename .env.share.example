# Server-only values. Do not prefix these with VITE_.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Public HTTPS address where server/share-server.mjs is deployed.
PUBLIC_SHARE_ORIGIN=https://share.example.com
ALLOWED_ORIGIN=https://your-vite-app.example

# Vite client value. This is the only share-server setting exposed to the browser.
VITE_SHARE_API_URL=https://share.example.com
